# Environment variables for Cloud Storage → Cloud Run → BigQuery pipeline
# Copy this file to .env and fill in your values

# Google Cloud Project
PROJECT_ID=your-project-id
REGION=us-central1
PROJECT_NUMBER=your-project-number

# BigQuery Configuration
DATASET_ID=github_archive
TABLE_ID=events

# Cloud Storage Configuration
BUCKET_NAME=your-project-id-data-pipeline

# Processing Configuration
BATCH_SIZE=500
MAX_RETRIES=3
LOG_LEVEL=INFO

# Data Source (for reference)
DATA_SOURCE=github-archive

# Service Account (for local development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
